# Copiez ce fichier en « .env » puis remplissez les valeurs.
# Mot de passe de la page des résultats (/admin). Sans lui, la page reste fermée.
ADMIN_PASSWORD=
# Port du serveur (3000 par défaut). Les hébergeurs le fournissent souvent eux-mêmes.
PORT=3000
# Emplacement de la base de données (data/questionnaire.db par défaut).
DB_PATH=
